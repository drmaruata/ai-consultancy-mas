# AI Consultancy MAS v3.0 — Environment Configuration
# Copy this file to .env and fill in your values

# ── LLM Providers (Priority: Anthropic → OpenAI → Gemini) ───────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxx
GEMINI_API_KEY=xxxxxxxx

# ── Context7 (MCP API) ──────────────────────────────────────────────
CONTEXT7_API_KEY=your-context7-api-key

# ── Supabase (Cloud) ────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── Kafka Redpanda Severless────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=your-redpanda-bootstrap-server
KAFKA_SASL_USERNAME=your-redpanda-username
KAFKA_SASL_PASSWORD=your-redpanda-password

# ── Upstash Vector (Vector DB) ──────────────────────────────────────
UPSTASH_VECTOR_REST_URL="https://your-upstash-vector-url"
UPSTASH_VECTOR_REST_TOKEN="your-upstash-vector-token"

# ── Upstash Workflow (replaces Temporal) ────────────────────────────
QSTASH_URL="https://your-qstash-url"
QSTASH_TOKEN="your-qstash-token"
QSTASH_CURRENT_SIGNING_KEY="your-qstash-current-signing-key"
QSTASH_NEXT_SIGNING_KEY="your-qstash-next-signing-key"

# ── Upstash Redis (Serverless Cache) ────────────────────────────────
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# ── Budget Controls ──────────────────────────────────────────────────
LLM_DAILY_BUDGET_USD=100.00
LLM_ALERT_THRESHOLD_PCT=0.80

# ── Application ──────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
